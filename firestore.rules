rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          "niyonshutiobed01@gmail.com"
        ]
      );
    }

    function hasValidDocumentId(diplomaId) {
      return diplomaId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$');
    }

    function isSafeString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isIsoDate(value) {
      return isSafeString(value, 10, 10) && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function hasAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        "documentType",
        "holderName",
        "studentNumber",
        "degree",
        "program",
        "faculty",
        "issuedOn",
        "deliveryMode",
        "status",
        "revokedReason"
      ]);
    }

    function hasRequiredKeys() {
      return request.resource.data.keys().hasAll([
        "documentType",
        "holderName",
        "studentNumber",
        "program",
        "faculty",
        "issuedOn",
        "deliveryMode",
        "status"
      ]);
    }

    function hasValidCommonFields() {
      return (
        isSafeString(request.resource.data.holderName, 1, 120) &&
        isSafeString(request.resource.data.studentNumber, 1, 80) &&
        isSafeString(request.resource.data.program, 1, 120) &&
        isSafeString(request.resource.data.faculty, 1, 120) &&
        isIsoDate(request.resource.data.issuedOn) &&
        request.resource.data.deliveryMode in ["Traditional Education", "Webinar"]
      );
    }

    function hasValidDocumentTypeFields() {
      return (
        request.resource.data.documentType == "Diploma" &&
        isSafeString(request.resource.data.degree, 1, 120)
      ) || (
        request.resource.data.documentType == "Transcript" &&
        !("degree" in request.resource.data)
      );
    }

    function hasValidStatusFields() {
      return request.resource.data.status in ["valid", "revoked"] && (
        (
          request.resource.data.status == "valid" &&
          !("revokedReason" in request.resource.data)
        ) || (
          request.resource.data.status == "revoked" &&
          isSafeString(request.resource.data.revokedReason, 3, 240)
        )
      );
    }

    function isValidDiplomaPayload(diplomaId) {
      return (
        hasValidDocumentId(diplomaId) &&
        hasAllowedKeys() &&
        hasRequiredKeys() &&
        hasValidCommonFields() &&
        hasValidDocumentTypeFields() &&
        hasValidStatusFields()
      );
    }

    function isIsoDateTime(value) {
      return isSafeString(value, 20, 40) && value.matches('^\\d{4}-\\d{2}-\\d{2}T');
    }

    function isNullableNumber(value) {
      return value is number || value == null;
    }

    function hasValidLogKeys() {
      return request.resource.data.keys().hasOnly([
        "diplomaId",
        "result",
        "eventType",
        "ip",
        "city",
        "region",
        "country",
        "latitude",
        "longitude",
        "userAgent",
        "createdAt"
      ]);
    }

    function hasValidLogFields() {
  return (
    hasValidDocumentId(request.resource.data.diplomaId) &&
    request.resource.data.result in ["found", "not_found", "error", "invalid", "event"] &&
    request.resource.data.eventType in ["verification", "page_view", "search_submit"] &&
    isSafeString(request.resource.data.createdAt, 20, 40) &&
    isSafeString(request.resource.data.ip, 0, 45) &&
    isSafeString(request.resource.data.city, 0, 120) &&
    isSafeString(request.resource.data.region, 0, 120) &&
    isSafeString(request.resource.data.country, 0, 120) &&
    isSafeString(request.resource.data.userAgent, 0, 320) &&
    isNullableNumber(request.resource.data.latitude) &&
    isNullableNumber(request.resource.data.longitude)
  );
}

function isValidLogPayload() {
      return hasValidLogKeys() &&
        request.resource.data.keys().hasAll(["diplomaId", "result", "eventType", "createdAt"]) &&
        hasValidLogFields();
    }

    match /verification_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidLogPayload();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /diplomas/{diplomaId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDiplomaPayload(diplomaId);
      allow delete: if isAdmin();
    }
  }
}





