{
    "firestore":  {
                      "rules":  "firestore.rules"
                  },
    "hosting":  {
                    "public":  "out",
                    "cleanUrls":  true,
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "headers":  [
                                    {
                                        "source":  "**",
                                        "headers":  [
                                                        {
                                                            "key":  "X-Robots-Tag",
                                                            "value":  "noindex, nofollow, noarchive, nosnippet"
                                                        },
                                                        {
                                                            "key":  "X-Content-Type-Options",
                                                            "value":  "nosniff"
                                                        },
                                                        {
                                                            "key":  "X-Frame-Options",
                                                            "value":  "DENY"
                                                        },
                                                        {
                                                            "key":  "Referrer-Policy",
                                                            "value":  "no-referrer"
                                                        },
                                                        {
                                                            "key":  "Permissions-Policy",
                                                            "value":  "camera=(), microphone=(), geolocation=()"
                                                        },
                                                        {
                                                            "key":  "Content-Security-Policy",
                                                            "value":  "default-src \u0027self\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; object-src \u0027none\u0027; form-action \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: https://res.cloudinary.com; connect-src \u0027self\u0027 https://*.googleapis.com https://*.firebaseio.com https://*.gstatic.com https://ipapi.co"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "functions":  {
                      "source":  "functions"
                  }
}
